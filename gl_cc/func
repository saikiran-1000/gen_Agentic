import azure.functions as func
import logging
import json
from main import main
import pandas as pd
app = func.FunctionApp(http_auth_level=func.AuthLevel.FUNCTION)
logger = logging.getLogger(__name__)

def final_transform(data, mapping):
    transformed_data = []
    
    for entry in data:
        transformed_entry = {}

        for key in entry:
            if key in mapping:
                transformed_entry[mapping[key]] = entry[key]
            else:
                transformed_entry[key] = entry[key]
        
        transformed_data.append(transformed_entry)
    
    return transformed_data



def replace_na(obj):
    if isinstance(obj, dict):
        return {k: replace_na(v) for k, v in obj.items()}
    elif isinstance(obj, list):
        return [replace_na(i) for i in obj]
    elif obj is pd.NA:
        return None
    else:
        return obj
@app.route(route="funcCodingPrediction")
def funcCodingPrediction(req: func.HttpRequest) -> func.HttpResponse:
    logger.info('Started funcCodingPrediction')

    if req.method == "POST":
        try:
            test_data = req.get_json()
        except ValueError:
            return func.HttpResponse(
                json.dumps({"error": "Invalid JSON format", "status_code": 400}),
                status_code=400,
                mimetype="application/json"
            )

        if not test_data:
            return func.HttpResponse(
                json.dumps({"error": "No data found for inferencing", "status_code": 400}),
                status_code=400,
                mimetype="application/json"
            )
        # transformed_data = transform_data(test_data, key_mapping)
        result = main(test_data)
        result = replace_na(result)

        if isinstance(result, dict) and "error" in result:
            return func.HttpResponse(
                json.dumps(result),
                status_code=result.get("status_code", 500),
                mimetype="application/json"
            )
        else:
            # result=final_transform(result,key_mapping)
            return func.HttpResponse(
                json.dumps(result),
                status_code=200,
                mimetype="application/json"
            )

    return func.HttpResponse("Only POST method is supported.", status_code=405)
