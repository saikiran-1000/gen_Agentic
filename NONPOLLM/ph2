The pipeline expects the following input JSON structure for each invoice: 

{   

  "invoiceID": "INV12345",   

  "invoiceDate": "2025-04-08",      //(YYYY-MM-DD)   

  "approverName": "approver",   

  "vendorID": "5000367",   

  "masterGLCategories" : [ 

   { 

       “glCategory”: “Custodial Services”, 

      “glCategoryExplanation”: “Contracted janitorial or cleaning vendor payments”}, 

{ 

       “glCategory”: “Cleaning Services”, 

        “glCategoryExplanation”: “Services for cleaning/sanitation”}, 

{ 

    “glCategory”: “Accounts Payable – Intercompany”, 

   “glCategoryExplanation”: “Intercompany service or management fee payables”}, 

{	    

   “glCategory”: “Communication Expenses”, 

   	  “glCategoryExplanation”: “Communication software subscriptions”}, 

{ 

    “glCategory”: "Travel Expense", 

   “glCategoryExplanation”: “various costs incurred during business travel”}, 

{	    

   “glCategory”: “IT serivices”, 

   	  “glCategoryExplanation”: “Fees paid for external IT support and maintenance services.”}, 

], 

  "invoiceLineItems": [   

      {   

