"""
Invoice processing module for Non-PO Invoice Coding for Line Description Matching.
This module contains functions for orchestrating the processing of invoice data,
calling the LLM for each line item, and validating the responses.
"""
import logging
import json
from typing import Any, Dict

from line_description_matching.line_desc_match_llm_call import get_azure_openai_response
from line_description_matching.line_desc_match_output_validation import llm_response_validation

logger = logging.getLogger(__name__)

def preprocess_invoice(data):
    """
    Converts raw invoice data into a structured format for processing.
    """
    logger.info("Preprocessing invoice data for Line Description Matching.")
    result = []
    for item in data["invoiceLineItems"]:
        line_entry = {
            "line_description": item["lineDescription"],
            "historicallyMatchedLineDescriptions": []
        }
        for match in item["historicallyMatchedLineDescriptions"]:
            matched_descriptions = [
                desc["matchedLineDescription"] for desc in match["lineDescriptions"]
            ]
            line_entry["historicallyMatchedLineDescriptions"].append({
                "glCategory": match["glCategory"],
                "glCategoryExplanation": match["glCategoryExplanation"],
                "lineDescriptions": matched_descriptions
            })
        result.append(line_entry)
    logger.info("Preprocessing completed for Line Description Matching")
    return result

def process_invoice(upstream_data: Dict[str, Any], config: Dict[str, Any]) -> Dict[str, Any]:
    """
    Processes the invoice data, calls the LLM for each line item,
    validates responses, and returns results.
    Args:
        upstream_data (Dict[str, Any]): Upstream invoice data containing invoice and line items.
        config (Dict[str, Any]): Configuration with system and user prompts.
    Returns:
        Dict[str, Any]: Results containing validated GL categories for each invoice line item.
    Raises:
        ValueError: If LLM response or output validation fails.
    """
    logger.info("Starting invoice processing for Line Description Matching.")
    output = {
        "invoiceID": upstream_data.get("invoiceID"),
        "invoiceDate": upstream_data.get("invoiceDate"),
        "vendorID": upstream_data.get("vendorID"),
        "approverName": upstream_data.get("approverName", "approver"),
        "invoiceLineItemsResults": []
    }

    preprocessed_lines = preprocess_invoice(upstream_data)
    system_prompt = config.get("line_desc_match_system_prompt")
    user_prompt_template = config.get("line_desc_match_user_prompt")

    for original, processed in zip(upstream_data["invoiceLineItems"], preprocessed_lines):
        line_id = original.get("invoiceLineID")
        line_desc = original.get("lineDescription")
        match_result = "NA"

        if processed["historicallyMatchedLineDescriptions"]:
            prompt = user_prompt_template.format(input_data=processed)
            logger.info(f"Calling LLM for invoice line for Line Description Matching.: {line_id}")
            try:
                llm_response_content, _ = get_azure_openai_response(system_prompt, prompt, config)
            except KeyError as e:
                error_message = f"##NON-PO-CODING-LINE-DESCRIPTION-MATCHING-ERROR## Missing configuration or prompt template key: {e}"
                logger.error(f"Line item {line_id}: {error_message}", exc_info=True)
                raise ValueError(error_message) from e
            except (TypeError, AttributeError) as e:
                error_message = f"##NON-PO-CODING-LINE-DESCRIPTION-MATCHING-ERROR## Prompt formatting error - invalid data type or attribute for Line Description Matching.: {e}"
                logger.error(f"Line item {line_id}: {error_message}", exc_info=True)
                raise ValueError(error_message) from e
            except ValueError as e:
                error_message = f"##NON-PO-CODING-LINE-DESCRIPTION-MATCHING-ERROR## LLM API error: {e}"
                logger.error(f"Line item {line_id}: {error_message}", exc_info=True)
                raise ValueError(error_message) from e
            except Exception as e:
                error_message = f"##NON-PO-CODING-LINE-DESCRIPTION-MATCHING-ERROR## Unexpected error in LLM call: {e}"
                logger.error(f"Line item {line_id}: {error_message}", exc_info=True)
                raise ValueError(error_message) from e
            try:
                logger.debug(f"Parsing and validating LLM response for line item {line_id} for Line Description Matching.")
                formatted_response = json.loads(llm_response_content)
                llm_response_validation(formatted_response)
                match_result = formatted_response.get("match", "NA")
                logger.debug(f"LLM response validated successfully for line item {line_id} for Line Description Matching.")
                
            except json.JSONDecodeError as e:
                logger.error(f"JSON parsing error for line item {line_id}: {e}", exc_info=True)
                error_message = f"##NON-PO-CODING-LINE-DESCRIPTION-MATCHING-ERROR## LLM response JSON parsing error: {e}"
                raise ValueError(error_message) from e
            except ValueError as e:
                logger.error(f"Validation error for line item {line_id}: {e}", exc_info=True)
                error_message = f"##NON-PO-CODING-LINE-DESCRIPTION-MATCHING-ERROR## LLM line level response schema validation error: {e}"
                raise ValueError(error_message) from e
 
        output["invoiceLineItemsResults"].append({
            "invoiceLineID": line_id,
            "lineDescription": line_desc,
            "matchingLineDescription": match_result
        })
    logger.info("Invoice processing completed for Line Description Matching.")
    return output
