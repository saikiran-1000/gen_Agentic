"""  
Output validation module for Non-PO Invoice Coding for GL Category Identification.  
  
This module provides validation functions and Pydantic models to ensure that  
the output from the LLM and the overall invoice output conform to the expected schemas.  
"""  
import logging 
from typing import List, Dict  
from pydantic import BaseModel, ValidationError 

logger = logging.getLogger(__name__)
  
class InvoiceLineItemResults(BaseModel):  
    """  
    Represents the validated results for a single invoice line item.  
  
    Attributes:  
        invoiceLineID (str): Unique identifier for the invoice line item.  
        lineDescription (str): Description of the invoice line item.  
        glCategories (List[str]): List of GL categories suggested for the line item.  
    """  
    invoiceLineID: str  
    lineDescription: str  
    glCategories: List[str]  
  
class LLMOutput(BaseModel):  
    """  
    Represents the output structure returned by the LLM.  
  
    Attributes:  
        glCategories (List[str]): List of GL categories suggested by the LLM.  
    """  
    glCategories: List[str]  
  
class FinalOutput(BaseModel):  
    """  
    Represents the final output structure for the entire invoice.  
  
    Attributes:  
        vendorID (str): Vendor identifier.  
        invoiceID (str): Invoice identifier.  
        invoiceDate (str): Date of invoice.  
        approverName (str): Name of approver.  
        invoiceLineItemsResults (List[InvoiceLineItemResults]): Validated results for each line item.  
    """  
    vendorID: str  
    invoiceID: str  
    invoiceDate: str  
    approverName: str  
    invoiceLineItemsResults: List[InvoiceLineItemResults]  
  
def llm_response_validation(llm_response: dict) -> None:  
    """  
    Validates the output from the LLM response.  
  
    Args:  
        llm_response (dict): LLM response to be validated.  
    Raises:  
        ValueError: If the LLM response does not match the expected schema.  
    """  
    logger.info("Validating LLM response output schema for GL Category Identification.")
    try:  
        LLMOutput(**llm_response) 
        logger.info("LLM response schema validation successful for GL Category Identification.") 
    except ValidationError as e:  
        error_message = (  
            "##NON-PO-CODING-GL-CATEGORIES-IDENTIFICATION-ERROR## Output JSON Schema Validation Error in LLM response: {}".format(e)  
        )  
        raise ValueError(error_message) from e  
  
def output_validation(results: Dict) -> None:  
    """  
    Validates the final output format for the invoice.  
  
    Args:  
        results (dict): The results dictionary to validate.  
    Raises:  
        ValueError: If the output does not match the expected schema.  
    """  
    try:  
        FinalOutput(**results)  
    except ValidationError as e:  
        error_message = (  
            "##NON-PO-CODING-GL-CATEGORIES-IDENTIFICATION-ERROR## Output JSON Schema Validation Error: {}".format(e)  
        )  
        raise ValueError(error_message) from e  
