"""Module for orchestrating Non-PO Invoice Coding workflow for GL Category Identification."""
import logging

from typing import Any, Dict
# from dotenv import load_dotenv

# from gl_categories_input_validation import input_validation
# from gl_categories_process_invoice import process_invoice
# from gl_categories_output_validation import output_validation
from gl_categories_identification.gl_categories_input_validation import input_validation
from gl_categories_identification.gl_categories_process_invoice import process_invoice
from gl_categories_identification.gl_categories_output_validation import output_validation



# load_dotenv()

def gl_categories_main(input_data: Dict[str, Any], config: Dict[str, Any]) -> Dict[str, Any]:
    """  
    Orchestrates the end-to-end Non-PO Invoice Coding workflow:  
    - Validates the input invoice data structure.  
    - Processes each invoice line item using an LLM to assign GL categories.  
    - Validates the final output structure.  
  
    Args:  
        input_data (Dict[str, Any]): Raw invoice data to be processed.  
        config (Dict[str, Any]): Configuration dictionary, including prompts and key mappings.  
  
    Returns:  
        Dict[str, Any]:   
            - On success: The fully processed and validated invoice data.  
            - On failure: An error dictionary containing 'error' and 'status' keys indicating the stage that failed.  
  
    Raises:  
        None. All exceptions are caught and logged; errors are returned in the response dictionary.  
    """ 

    logging.info(f"Processing input: {input_data}")
    try:
        validated_data = input_validation(input_data, config)
    except ValueError as e:
        logging.error(f"Input validation error: {e}")
        return {
            "error": str(e),
            "status": "Input validation failed"
        }

    try:
        processed_invoice = process_invoice(validated_data, config)
    except ValueError as e:
        logging.error(f"Invoice processing error: {e}")
        return {
            "error": str(e),
            "status": "Invoice processing failed"
        }

    try:
        output_validation(processed_invoice)
    except ValueError as e:
        logging.error(f"Output validation error: {e}")
        return {
            "error": str(e),
            "status": "Output validation failed"
        }

    return {"status": "success","status_code":200, "data": processed_invoice}
    # return processed_invoice



