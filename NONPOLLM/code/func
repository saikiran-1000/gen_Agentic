# REMAP KEYS
def remap_keys(data: dict, mapping: dict) -> dict:
    """Recursively rename keys in a dict based on mapping."""
    if isinstance(data, dict):
        new_dict = {}
        for k, v in data.items():
            new_key = mapping.get(k, k)  # fallback to original key if not in mapping
            new_dict[new_key] = remap_keys(v, mapping)
        return new_dict
    elif isinstance(data, list):
        return [remap_keys(item, mapping) for item in data]
    else:
        return data
