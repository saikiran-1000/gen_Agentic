        # result2_1["final_output"]["data"].extend(gl_cc_res_nonLLM.get("data", []))
        # result2_1["final_output"]["data"].extend(gl_cc_res_llm.get("data", []))

        logging.info("GLCC prediction executed successfully.")
        ####################### LOW CONFIDENCE ##################
        
        logging.info("Confidence score logic started")
        try:
            data = result2_1
        except Exception as e:
            logger.error(f"Failed to load result2_1: {e}")

        low_conf_ids = set()

        # --------------------------
        # Extract low confidence from llm_data
        # --------------------------
        try:
            llm_items = data.get("llm_data", {}).get("invoiceLineItems", [])
            for item in llm_items:
                try:
                    low_info = item.get("low_confidence", {})
                    if str(low_info.get("present")).lower() == "true":
                        low_conf_ids.add(item.get("invoiceLineID"))
                except Exception as e:
                    logger.error(f"Error processing llm_data item: {e}")
        except Exception as e:
            logger.error(f"Error reading llm_data: {e}")

        # --------------------------
        # Extract low confidence from non_llm_lines
        # --------------------------
        try:
            for item in data.get("non_llm_lines", []):
                try:
                    low_info = item.get("low_confidence", {})
                    if str(low_info.get("present")).lower() == "true":
                        low_conf_ids.add(item.get("ID"))
                except Exception as e:
                    logger.error(f"Error processing non_llm_lines item: {e}")
        except Exception as e:
            logger.error(f"Error reading non_llm_lines: {e}")

        # --------------------------
        # Update final_output confidence scores
        # --------------------------
        try:
            for entry in data.get("final_output", {}).get("data", []):
                try:
                    line_id = entry.get("ID")
                    if line_id in low_conf_ids:
                        entry["GL Code"]["confidence_score"] = config.get("confidence_threshold")
                        entry["Cost Code"]["confidence_score"] = config.get("confidence_threshold")
                except Exception as e:
                    logger.error(f"Error updating confidence for entry {entry}: {e}")
        except Exception as e:
            logger.error(f"Error iterating final_output data: {e}")
        result_to_return=result2_1.get("final_output").get("data")
        result_to_return=dedupe_by_score(result_to_return)
        return func.HttpResponse(
            json.dumps(result_to_return),
            # json.dumps(result2_1),
            status_code=200,
            mimetype="application/json"
        )
    except Exception as e:
        logger.error(f"Error building final output: {e}")
        return func.HttpResponse(
            json.dumps({"error": str(e)}),
            status_code=500,
            mimetype="application/json"
        )
    
