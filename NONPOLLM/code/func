from typing import List, Dict, Any


def dedupe_by_score(data: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Deduplicate a list of invoice prediction dictionaries based on ID.
    For duplicate IDs:
        1. Keep the one with higher GL Code confidence_score.
        2. If tied, keep the one with higher Cost Code confidence_score.

    Args:
        data (list): List of prediction dicts.

    Returns:
        list: Deduplicated list with best-scored dict per ID.
    """

    best_records = {}

    for item in data:
        # Validate required keys
        item_id = item.get("ID")
        if item_id is None:
            # Skip silently or log — your choice:
            # logger.warning("Record skipped: missing ID field")
            continue

        gl_score = (
            item.get("GL Code", {}).get("confidence_score", float("-inf"))
        )
        cost_score = (
            item.get("Cost Code", {}).get("confidence_score", float("-inf"))
        )

        # If first time seeing this ID, store it
        if item_id not in best_records:
            best_records[item_id] = item
            continue

        # Compare with existing record
        existing = best_records[item_id]
        existing_gl = existing.get("GL Code", {}).get("confidence_score", float("-inf"))
        existing_cost = existing.get("Cost Code", {}).get("confidence_score", float("-inf"))

        # Decide replacement: GL score wins first
        if gl_score > existing_gl:
            best_records[item_id] = item
        elif gl_score == existing_gl and cost_score > existing_cost:
            best_records[item_id] = item

    return list(best_records.values())

def fetch_config(container_name, blob_name):
    try:
        container_client = blob_service_client.get_container_client(container_name)
        blob_client = container_client.get_blob_client(blob_name)

        # Download blob content
        download_stream = blob_client.download_blob()
        config_data = download_stream.readall()

        # Parse JSON string to dict
        config_dict = json.loads(config_data)
        logger.info(f"Fetched {blob_name} from {container_name}")
        return config_dict
    except Exception as e:
        logger.error(f"Error fetching config: {e}")
        return None


