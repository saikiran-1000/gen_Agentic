def clean_dataframe(df, config):
    """
    Filters DataFrame based on relevant_fields and removes empty critical rows.
    """
    try:
        cfg = config["AzureAIConfig"]
        relevant_fields = cfg.get("relevant_fields", [])
        
        # Check if mandatory fields exist in DF
        existing_fields = [col for col in relevant_fields if col in df.columns]
        
        if not existing_fields:
            logger.warning("No mandatory fields found in dataframe!")
            return pd.DataFrame()

        # Drop rows where ANY of the existing relevant fields are totally empty
        # (Adjust logic if you only want to drop if KEY field is empty)
        df = df.dropna(subset=existing_fields)
        df = df[existing_fields]
        # Remove rows where fields are just whitespace
        mask = df[existing_fields].apply(lambda x: x.astype(str).str.strip().eq("")).any(axis=1)
        df_clean = df[~mask].copy()
        
        # Fill remaining NaNs with "N/A"
        df_clean.fillna("N/A", inplace=True)
        
        logger.info(f"Data Cleaning: {len(df)} -> {len(df_clean)} rows.")
        return df_clean
    except Exception as e:
        raise ValueError(f"Error while removing irrelevant fields from csv file: {e}")

