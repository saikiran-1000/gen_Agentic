def get_blob_service_client(connection_string):
    return BlobServiceClient.from_connection_string(connection_string)

def fetch_and_merge_csvs(blob_service_client, container_name):
    """
    Downloads all CSVs from the container and merges them into a single DataFrame.
    """
    try:
        container_client = blob_service_client.get_container_client(container_name)
        blobs = list(container_client.list_blobs())
    except Exception as e:
        raise ValueError(f"Error accessing container '{container_name}': {e}")
        # return pd.DataFrame()

    csv_blobs = [b.name for b in blobs if b.name.lower().endswith(".csv")]
    
    if not csv_blobs:
        logger.warning("No CSV blobs found.")
        return pd.DataFrame()

    dfs = []
    encodings = ["utf-8", "utf-8-sig", "latin1", "cp1252"]

    for blob_name in csv_blobs:
        try:
            blob_client = container_client.get_blob_client(blob_name)
            blob_bytes = blob_client.download_blob().readall()
            
            # Smart decoding
            blob_text = None
            for enc in encodings:
                try:
                    blob_text = blob_bytes.decode(enc)
                    break
                except UnicodeDecodeError:
                    continue
            
            if blob_text is None:
                logger.error(f"Failed to decode {blob_name}. Skipping.")
                continue

            # Read CSV
            df = pd.read_csv(
                StringIO(blob_text), 
                dtype=str, 
                keep_default_na=False
            )
            dfs.append(df)
            logger.info(f"Loaded {blob_name} ({len(df)} rows)")

        except Exception as e:
            raise ValueError(f"Error processing blob {blob_name}: {e}")

    if not dfs:
        return pd.DataFrame()
    try:
        final_df = pd.concat(dfs, ignore_index=True)
    except Exception as e:
        raise ValueError(f"Error while concatenating all dataframe from csv files {blob_name}: {e}")
    return final_df

def archive_processed_blobs(blob_service_client, source_container, target_container, replaced_flag):
    """
    Moves processed blobs to a consumed container if replaced='yes'.
    Includes copy-status verification to prevent data loss.
    """
    # 1. Early Exit check
    if not replaced_flag or str(replaced_flag).lower() != "yes":
        logger.info("Archive skipped: 'replaced' flag is not set to 'yes'.")
        return

    try:
        source_client = blob_service_client.get_container_client(source_container)
        target_client = blob_service_client.get_container_client(target_container)

        # if not target_client.exists():
        #     logger.info(f"Creating target container: {target_container}")
        #     target_client.create_container()

        try:
            target_client.get_container_properties()
            logger.info(f"Target container '{target_container}' already exists")
        except ResourceNotFoundError:
            logger.info(f"Creating target container: {target_container}")
            target_client.create_container()

        # List only CSV blobs
        blobs = source_client.list_blobs()
        csv_blobs = [b.name for b in blobs if b.name.lower().endswith(".csv")]

        if not csv_blobs:
            logger.info("No CSV files found to archive.")
            return

        logger.info(f"Starting archiving process for {len(csv_blobs)} files...")

    except Exception as e:
        logger.error(f"Failed to initialize archive clients: {e}")
        raise # Critical failure during initialization

    for blob_name in csv_blobs:
        try:
            source_blob = source_client.get_blob_client(blob_name)
            target_blob = target_client.get_blob_client(blob_name)
            
            # Start copy operation
            copy_props = target_blob.start_copy_from_url(source_blob.url)
            
            # --- Verification Logic ---
            # For large blobs, copy might be asynchronous. We check the status.
            copy_id = copy_props['copy_id']
            status = copy_props['copy_status']
            
            # In most cases for internal Azure copies, this is 'success' immediately
            if status == 'success':
                source_blob.delete_blob()
                logger.info(f"Successfully archived: {blob_name}")
            else:
                # If status is 'pending', we log it and avoid deleting the source
                logger.warning(f"Copy for {blob_name} is {status} (ID: {copy_id}). Source not deleted.")

        except Exception as e:
            logger.error(f"Failed to archive blob '{blob_name}': {e}")
            # We continue the loop so one bad file doesn't block the rest
            continue

    logger.info("Archive process completed.")

