def ensure_index_exists(index_client, config):
    """
    Creates the index if it doesn't exist, strictly following the config schema.
    """
    cfg = config["AzureAIConfig"]
    index_name = cfg["index_name"]
    vector_fields_cfg = cfg.get("vector_fields", {})

    try:
        index_client.get_index(index_name)
        logger.info(f"Index '{index_name}' already exists.")
    except ResourceNotFoundError:
        logger.info(f"Index '{index_name}' not found. Creating...")
        try:
            fields = []
            
            # Helper lists
            searchable = set(cfg.get("searchable", []))
            filterable = set(cfg.get("filterable", []))
            facetable = set(cfg.get("facetable", []))
            retrievable = set(cfg.get("retrievable", []))
            key_field = cfg["key_field"]

            # 1. Add Standard Fields
            for field_name in cfg.get("relevant_fields", []):
                if field_name in vector_fields_cfg: 
                    continue # Skip vector fields here

                field_kwargs = {
                    "name": field_name,
                    "type": SearchFieldDataType.String,
                    "retrievable": (field_name in retrievable or field_name == key_field)
                }

                if field_name == key_field:
                    fields.append(SimpleField(**field_kwargs, key=True))
                elif field_name in searchable:
                    fields.append(SearchableField(**field_kwargs, searchable=True))
                else:
                    fields.append(SimpleField(
                        **field_kwargs,
                        filterable=(field_name in filterable),
                        facetable=(field_name in facetable),
                        sortable=(field_name in filterable)
                    ))

            # 2. Add Vector Fields
            for vec_name, vec_cfg in vector_fields_cfg.items():
                fields.append(SearchField(
                    name=vec_name,
                    type=SearchFieldDataType.Collection(SearchFieldDataType.Single),
                    searchable=True,
                    vector_search_dimensions=vec_cfg.get("dimensions"),
                    vector_search_profile_name="vector-profile"
                ))

            # 3. Define Vector Config
            vector_search = VectorSearch(
                algorithms=[HnswAlgorithmConfiguration(name="hnsw-config")],
                profiles=[
                    VectorSearchProfile(
                        name="vector-profile",
                        algorithm_configuration_name="hnsw-config"
                    )
                ]
            )

            # 4. Create
            index = SearchIndex(name=index_name, fields=fields, vector_search=vector_search)
            index_client.create_index(index)
            logger.info(f"Index '{index_name}' created successfully.")
        except Exception as e:
            raise ValueError(f"Error while creating new index for Azure AI Search for new csv file: {e}")

def get_existing_keys(search_client, key_field):
    """
    Fetches all existing IDs to avoid re-uploading.
    """
    try:
        results = search_client.search(search_text="*", select=[key_field])
        # Use a set for O(1) lookup
        keys = {str(doc[key_field]) for doc in results}
        logger.info(f"Found {len(keys)} existing documents in index.")
        return keys
    except Exception as e:
        logger.error(f"Error fetching existing keys: {e}")
        return set()

# ---------------------------------------------------------
# 4. BATCH PROCESSING (MEMORY OPTIMIZED)
# ---------------------------------------------------------

def process_batches(df, config, openai_client, search_client, existing_keys):
    """
    Main loop: Filter -> Embed -> Upload -> Cleanup.
    This ensures we never hold embeddings for the whole dataset in memory.
    Includes robust error handling and configuration validation.
    """
    # ---------------------------------------------------------
    # 1. VALIDATION & SETUP
    # ---------------------------------------------------------
    try:
        cfg = config["AzureAIConfig"]
        key_field = cfg["key_field"]
        searchable_cols = cfg.get("searchable", [])
        
        # Validate Vector Fields
        vector_fields = cfg.get("vector_fields", {})
        if not vector_fields:
            raise ValueError("Configuration Error: 'vector_fields' must be defined in AzureAIConfig.")
        
        vector_field_name = list(vector_fields.keys())[0]  # Assumes one vector field
        
        # Validate Embedding Model Config
        hist_config = config.get("historical_data_filter_and_retrieval", {})
        # emb_model = hist_config.get("embedding_model")
        emb_model = os.getenv('AZURE_OPENAI_MODEL_embed')
        if not emb_model:
            raise KeyError("Configuration Error: 'AZURE_OPENAI_MODEL_embed' is missing in Env Variables.")

    except (KeyError, ValueError, TypeError) as e:
        logger.error(f"Initialization Failed to store data in Azure AI Search: {e}")
        raise  # Critical error: Cannot proceed without valid config

    batch_size = 100
    total_new = 0
    total_skipped = 0
    failed_batches = 0
    
    total_rows = len(df)
    logger.info(f"Starting batch processing for {total_rows} rows...")

    # ---------------------------------------------------------
    # 2. BATCH PROCESSING LOOP
    # ---------------------------------------------------------
    for i in range(0, total_rows, batch_size):
        try:
            # --- Step A: Slice & Prepare ---
            df_batch = df.iloc[i : i + batch_size].copy()
            batch_docs = df_batch.to_dict(orient="records")
            
            # Filter duplicates
            docs_to_upload = []
            for doc in batch_docs:
                doc_id = str(doc.get(key_field, ""))
                if doc_id in existing_keys:
                    total_skipped += 1
                else:
                    docs_to_upload.append(doc)
            
            if not docs_to_upload:
                continue

            # --- Step B: Generate Embeddings ---
            texts_to_embed = []
            try:
                for doc in docs_to_upload:
                    # Robust text combination: Handle None/NaN values safely
                    text_parts = [str(doc.get(col, "") or "") for col in searchable_cols]
                    combined_text = " ".join(text_parts).strip()
                    texts_to_embed.append(combined_text if combined_text else " ")

                response = openai_client.embeddings.create(
                    input=texts_to_embed,
                    model=emb_model
                )
                embeddings = [list(item.embedding) for item in response.data]

                if len(embeddings) != len(docs_to_upload):
                    raise ValueError(f"Mismatch: Generated {len(embeddings)} embeddings for {len(docs_to_upload)} docs.")

                # Assign embeddings
                for doc, emb in zip(docs_to_upload, embeddings):
                    doc[vector_field_name] = emb

            except Exception as e:
                tt=i+batch_size
                logger.error(f"Embedding Failed for batch starting at row {i} and ends at {tt}: {e}")
                failed_batches += 1
                continue  # Skip upload for this batch, move to next

            # --- Step C: Upload to Azure Search ---
            try:
                res = search_client.upload_documents(documents=docs_to_upload)
                
                succeeded = sum(1 for r in res if r.succeeded)
                failed_in_batch = len(docs_to_upload) - succeeded
                total_new += succeeded
                
                if failed_in_batch > 0:
                    logger.warning(f"Batch {i//batch_size + 1}: {failed_in_batch} documents failed to index.")
                else:
                    logger.info(f"Batch {i//batch_size + 1}: Uploaded {succeeded} new docs.")

            except Exception as e:
                logger.error(f"Indexing Failed for batch starting at row {i}: {e}")
                failed_batches += 1
                # We do not raise here so subsequent batches can still try to process

        except Exception as e:
            # Catch-all for unexpected dataframe/logic errors in the loop
            logger.error(f"Unexpected error in batch processing logic at row {i}: {e}")
            failed_batches += 1
        
        finally:
            # --- Step D: Memory Cleanup ---
            # Ensure these are deleted even if errors occurred
            if 'docs_to_upload' in locals(): del docs_to_upload
            if 'texts_to_embed' in locals(): del texts_to_embed
            if 'batch_docs' in locals(): del batch_docs

    # ---------------------------------------------------------
    # 3. SUMMARY & FINAL CHECK
    # ---------------------------------------------------------
    logger.info("------------------------------------------------")
    logger.info(f"Processing Complete.")
    logger.info(f"Total New Uploads: {total_new}")
    logger.info(f"Total Skipped:     {total_skipped}")
    logger.info(f"Failed Batches:    {failed_batches}")
    logger.info("------------------------------------------------")

    # Optional: Raise error if TOO many batches failed (e.g., system-wide issue)
    if failed_batches > 0 and total_new == 0:
        raise RuntimeError("Process completed but ALL batches failed. Check logs for details.")

