        #     credential=AzureKeyCredential(admin_key), 
        #     transport=transport
        # )
        # ------------------------------------------------------------------
        ###########################################################################################################
        index_client = SearchIndexClient(
            endpoint=endpoint, 
            credential=AzureKeyCredential(admin_key)
        )
        search_client = SearchClient(
            endpoint=endpoint, 
            index_name=config["AzureAIConfig"]["index_name"], 
            credential=AzureKeyCredential(admin_key)
        )
        ###########################################################################################################

        openai_client = AzureOpenAI(
            api_key=os.getenv("AZURE_OPENAI_API_KEY_embd"),
            azure_endpoint=os.getenv("AZURE_OPENAI_ENDPOINT_embd"),
            api_version=os.getenv("AZURE_OPENAI_API_VERSION_embd")
        )
        
        blob_service = get_blob_service_client(blob_conn_str)

        # 2. Load & Merge Data
        try:
            df_final = fetch_and_merge_csvs(blob_service, "historicaldata")
        except Exception as e:
            logger.error(f"Failed to fetch or merge CSVs: {e}")
            raise

        if df_final is None or df_final.empty:
            logger.info("No data found to process. Exiting gracefully.")
            return

        # 3. Clean Data
        df_final = clean_dataframe(df_final, config)
        if df_final.empty:
            logger.info("Dataframe is empty after cleaning. Exiting.")
            return

        # 4. Search Index Setup (Creates index if not exists)
        try:
            ensure_index_exists(index_client, config)
        except Exception as e:
            logger.error(f"Failed to ensure search index exists: {e}")
            raise

        # 5. Get Existing Keys (Optimization to prevent redundant embedding/indexing)
        existing_keys = get_existing_keys(search_client, config["AzureAIConfig"]["key_field"])

        # 6. Process, Embed, Upload (Memory-safe Batched Processing)
        # Errors within batches are handled inside this function to allow partial success
        process_batches(df_final, config, openai_client, search_client, existing_keys)

        # 7. Cleanup Blobs
        # Set replaced_flag based on your specific logic requirements
        replaced_flag = "yes" 
        archive_processed_blobs(blob_service, "historicaldata", "consumedhistoricaldata", replaced_flag)

        logger.info("Main Data Upload Pipeline completed successfully.")

    except Exception as e:
        logger.critical(f"Pipeline failed with a critical error: {e}", exc_info=True)
        # In production, you might want to re-raise or trigger an alert here
        raise ValueError(f"Data upload to Azure AI Search Pipeline failed with a critical error: {e}")
