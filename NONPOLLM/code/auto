def main_data_upload(config):
    """
    Orchestrates the entire ETL pipeline.
    """
    logger.info("Starting Main Data Upload Pipeline...")
    
    try:
        # 1. Environment & Client Setup
        # We use a get() or os.getenv() check to ensure critical secrets are present
        blob_conn_str=os.getenv('AzureWebJobsStorage')
        endpoint = os.getenv("endpoint")
        admin_key = os.getenv("admin_key")
        
        if not endpoint or not admin_key:
            raise EnvironmentError("Missing 'endpoint' or 'admin_key' environment variables.")
        ###########################################################################################################
        # --- Client Initialization (Maintained as per your requirement) ---
        # from azure.core.pipeline.transport import RequestsTransport
        # transport = RequestsTransport(connection_verify=False)
        
        # index_client = SearchIndexClient(
