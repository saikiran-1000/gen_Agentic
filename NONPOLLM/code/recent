from typing import Tuple, Dict, List, Any
import os
import json 
import logging
from azure.storage.blob import BlobServiceClient
from azure.core.exceptions import ResourceNotFoundError
import pandas as pd
from io import BytesIO


logger = logging.getLogger(__name__)

def get_blob_service_client(blob_connection_string):
    # Initialize BlobServiceClient
    blob_client = BlobServiceClient.from_connection_string(blob_connection_string)
    return blob_client
 
def get_or_create_container(blob_service_client, container_name,config):
    """
    Create container if it doesn't exist.
    If container exists but has no CSV/XLSX file, upload the provided file.
    If one file exists:
        - If local_file_path is given, delete existing and upload new file.
        - Else, download and return it as DataFrame.
    If multiple CSV/XLSX files exist, raise error.
    Always returns a DataFrame if no error occurs.
    """
    try:
        container_client = blob_service_client.get_container_client(container_name)

        # Check if container exists
        try:
            container_client.get_container_properties()
            logger.info(f"Container '{container_name}' already exists.")
        except ResourceNotFoundError:
            container_client.create_container()
            logger.info(f"Container '{container_name}' created.")

        # List existing blobs
        blobs = list(container_client.list_blobs())
        valid_blobs = [
            blob.name for blob in blobs
            if blob.name.endswith(".csv") or blob.name.endswith(".xlsx")
        ]

        blob_name = None

        # --- Case 1: Empty container ---
        if len(valid_blobs) == 0:
            raise ValueError(f"{config["glMaster_container_name"]} container is empty and no csv or xlsx file found.")


        # --- Case 2: Multiple files ---
        elif len(valid_blobs) > 1:
            raise ValueError(f"Multiple CSV/XLSX files found: {valid_blobs}")

        # --- Case 3: Single existing file ---
        else:
            existing_blob = valid_blobs[0]
            blob_name = existing_blob

        # --- At this point, blob_name definitely exists ---
        blob_data = container_client.download_blob(blob_name)
        file_bytes = blob_data.readall()

        # Convert to DataFrame
        if blob_name.lower().endswith(".csv"):
            df = pd.read_csv(BytesIO(file_bytes),dtype=str)
        elif blob_name.lower().endswith((".xlsx", ".xls")):
            df = pd.read_excel(BytesIO(file_bytes),dtype=str)
        else:
            raise ValueError("Unsupported file format. Only .csv or .xlsx/.xls are allowed.")

        logger.info(f"Returning DataFrame from '{blob_name}' in '{container_name}'.")
        return df

    except Exception as e:
        logger.error(f"Error in get_or_create_container: {e}")
        raise


def fetch_filtered_rows(df, config):
    """
    Fetch unique 'glCategory' values created within the last N days.
    """
    try:
        filter_by_vendorId = config.get('filter_by_vendorId','no')
        if filter_by_vendorId=='yes':

            logger.info("Starting fetch_filtered_rows...")

            col_name = config.get("glCategory")
            date_col = config.get("gl_desc_created_date")
            days = config.get("days", 30)  # Default to 30 days if not provided
            # days = 1000

            if col_name not in df.columns or date_col not in df.columns:
                raise KeyError(f"Columns '{col_name}' or '{date_col}' not found in DataFrame")

            # Convert date column to datetime (format is yyyy-mm-dd)
            df[date_col] = pd.to_datetime(df[date_col], format="%Y-%m-%d", errors="coerce")

            # Calculate cutoff date using pandas (no datetime import)
            cutoff_date = pd.Timestamp.now() - pd.Timedelta(days=days)

            # Filter for last N days
            recent_df = df[df[date_col] >= cutoff_date]

            # Get unique non-null values
            result = recent_df[col_name].dropna().unique().tolist()

            logger.info("Fetched %d unique values from last %d days in column %s", len(result), days, col_name)
            return result
        
        else:
            logger.info("Starting fetch_filtered_rows...")

            col_name = config.get("glCategory")

            if col_name not in df.columns:
                raise KeyError(f"Columns '{col_name}' not found in DataFrame")
            
            result = df[col_name].dropna().unique().tolist()

            logger.info("Fetched %d unique values from column %s",
                        len(result), col_name)

            return result



    except Exception as e:
        logger.error("Error in fetch_filtered_rows: %s", e, exc_info=True)
        raise

def fetch_last_n_days(df, config):
    """
    ALWAYS returns last N days of glCategory (new_category requirement).
    """
    try:
        col_name = config.get("glCategory")
        date_col = config.get("gl_desc_created_date")
        days = config.get("days", 30)

        if col_name not in df.columns or date_col not in df.columns:
            raise KeyError(f"Columns '{col_name}' or '{date_col}' not found")

        df[date_col] = pd.to_datetime(df[date_col], format="%Y-%m-%d", errors="coerce")
        cutoff_date = pd.Timestamp.now() - pd.Timedelta(days=days)

        recent_df = df[df[date_col] >= cutoff_date]
        result = recent_df[col_name].dropna().unique().tolist()

        logger.info(f"New categories added: {result}")
        return result

    except Exception as e:
        logger.error("Error in fetch_last_n_days: %s", str(e))
        return []


def add_historical_data(request: Dict[str, Any], query_rows: List[Any]) -> Dict[str, Any]:
    """
    Add historical data to the request dictionary.

    Args:
        request (dict): The original request dictionary.
        query_rows (list): List of rows fetched from the database.

    Returns:
        dict: Updated request dictionary with 'GL_Master_data' key.
    """
    try:
        logger.info("Adding historical data to request...")

        if not isinstance(request, dict):
            raise TypeError("request must be a dictionary")
        if not isinstance(query_rows, list):
            raise TypeError("query_rows must be a list")

        logger.info(f"Query Rows: {len(query_rows)}")
        logger.info(f"Query Rows: {query_rows}")
        for query in query_rows:
            request["masterGLCategories"].append({"glCategory":query})

        logger.info(f"Length: {len(request["masterGLCategories"])}")
        logger.info("Historical data added successfully with %d rows", len(query_rows))
        return request

    except Exception as e:
        logger.error("Error in add_historical_data: %s", e, exc_info=True)
        raise


def validation_check(request: Dict[str, Any], config: Dict[str, Any]) -> bool:
    """
    Validate request and config dictionaries.

    Args:
        request (dict): Incoming request dictionary.
        config (dict): Configuration dictionary that must include
                       required keys with non-empty string values.

    Returns:
        bool: True if validation passes, False otherwise.
    """
    required_keys = ["gl_code", "glCategory", "gl_desc_created_date"]

    try:
        logger.info("Starting validation_check...")

        if not isinstance(request, dict):
            logger.error("Validation failed: 'request' must be a dictionary")
            return False
        if not isinstance(config, dict):
            logger.error("Validation failed: 'config' must be a dictionary")
            return False

        for key in required_keys:
            if key not in config:
                logger.error("Validation failed: Missing key '%s' in config", key)
                return False
            if not isinstance(config[key], str) or not config[key].strip():
                logger.error("Validation failed: Key '%s' must be a non-empty string", key)
                return False

        logger.info("Validation successful")
        return True

    except Exception as e:
        logger.error("Error in validation_check: %s", e, exc_info=True)
        return False

def main_gl_master(request: dict,config:dict) -> dict:
    """
    Main pipeline to validate request, fetch data, and enrich with historical data.

    Args:
        request (dict): Incoming request payload
        config (dict): Configuration dictionary

    Returns:
        dict: Updated request with historical data, or error response if failure
    """
    try:
        
        config=config.get("GLmasterdata_field_mapping")
        logger.info("Main process started.")
        blob_connection_string = os.getenv("AzureWebJobsStorage")
        check = validation_check(request, config)
        if not check:
            logger.error("Validation failed.")
            return {"status": "error", "message": "Validation failed."}
        blob_service_client = get_blob_service_client(blob_connection_string)
        df = get_or_create_container(
        blob_service_client, config.get("glMaster_container_name"),config)
        rows = fetch_filtered_rows(df, config)
        query_rows = json.loads(json.dumps(rows, indent=2, default=str))
        new_category = fetch_last_n_days(df, config)
        logger.info("Rows fetched and serialized. Count: %d", len(query_rows))
        # logger.info(f"Request before updated_result: {request}")
        updated_result = add_historical_data(request, query_rows)
        if "masterGLCategories" in request and not df.empty:
            for desc in request["masterGLCategories"]:
                temp_desc=desc["glCategory"]
                explain_list=df.loc[df[config.get("glCategory")] == temp_desc, config.get("glCategoryExplanation")].astype(str).unique().tolist()
                if len(explain_list)==0:
                    desc["glCategoryExplanation"]="NA"
                elif len(explain_list)==1:
                    desc["glCategoryExplanation"]=explain_list[0]
                else:
                    raise ValueError(f"Multiple glCategoryExplanation found for GLCategory: {temp_desc}")
                # desc["glCategoryExplanation"]=df.loc[df[config.get("glCategory")] == temp_desc, config.get("glCategoryExplanation")].astype(str).unique().tolist()[0]
        # logger.info(f"Request after updated_result: {request}")
        gl_mapping = {}
        if "masterGLCategories" in request and not df.empty:
            for desc in request["masterGLCategories"]:
                # logger.info(f"desc: {desc}")
                desc=desc["glCategory"]
                matched_codes = df.loc[df[config.get("glCategory")] == desc, config.get("gl_code")].astype(str).unique().tolist()
                gl_mapping[desc] = matched_codes if matched_codes else []

            logger.info("Generated GL description to code mapping. Count: %d", len(gl_mapping))

        # print("Updated Result: ", updated_result)
        logger.info("Main process completed successfully.")
        return {"status": "success", "data": request, "newCategories":new_category, "glDesc_info":gl_mapping}

    except Exception as e:
        logger.exception("Error in main pipeline.")
        return {
            "status": "error",
            "message": f"Main pipeline failed: {e}"
        }

