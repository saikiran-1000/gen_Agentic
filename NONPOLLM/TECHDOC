weightage_for_confidence_score_calculation_cc.score	float	Weight for semantic similarity score (CC)
weightage_for_confidence_score_calculation_cc.w_freq	float	Weight for frequency (CC)
weightage_for_confidence_score_calculation_cc.w_recency	float	Weight for recency (CC)
