def validate_config(config: dict, input_data: dict):
    """
    Validate config against input_data and internal rules.
    Returns:
        (True, None) if valid
        (False, "error message") if invalid
    """

    try:
        # ---------------------------------------------------------
        # 1. Check line_detail_identifier & master_data_identifier
        # ---------------------------------------------------------
        line_key = config.get("line_detail_identifier_in_input")          # e.g., "invoiceLineItems"
        master_key = config.get("master_data_identifier_in_input")        # e.g., "taxMasterDataLineItems"

        # line_key MUST be inside input_data
        if line_key not in input_data:
            return False, f"Missing '{line_key}' in input_data."

        line_records = input_data.get(line_key, [])

        # master_key MUST exist **inside each line item**, not in input_data root
        for idx, rec in enumerate(line_records):
            if master_key not in rec:
                return False, (
                    f"Missing '{master_key}' inside '{line_key}' at index {idx}."
                )

        # Use master data from first line item (structure assumed same)
        master_records = line_records[0].get(master_key, [])

        if not master_records:
            return False, f"'{master_key}' is empty inside '{line_key}'."

        # ---------------------------------------------------------
        # 2. field_to_extract_from_master_data must exist inside master records
        # ---------------------------------------------------------
        field_to_extract = config.get("field_to_extract_from_master_data")

        for idx, rec in enumerate(master_records):
            if field_to_extract not in rec:
                return False, (
                    f"'{field_to_extract}' not found in master record index {idx} "
                    f"inside '{master_key}'."
                )

        # ---------------------------------------------------------
        # 3. required_unique_field & arrangement_field must exist in relevant_fields
        # ---------------------------------------------------------
        relevant_cols = config.get("AzureAIConfig").get("relevant_fields", [])

        required_unique_field = config.get("required_unique_field")
        arrangement_field = config.get("arrangement_field")

        if required_unique_field not in relevant_cols:
            return False, (
                f"required_unique_field '{required_unique_field}' not found "
                f"in relevant_fields."
            )

        if arrangement_field not in relevant_cols:
            return False, (
                f"arrangement_field '{arrangement_field}' not found "
                f"in relevant_fields."
            )

        # ---------------------------------------------------------
        # 4. apply_filter_on_this_fields fields must be in filterable + searchable
        # ---------------------------------------------------------
        apply_filters = config.get("apply_filter_on_this_fields", {})
        filterable = config["AzureAIConfig"].get("filterable", [])
        searchable = config["AzureAIConfig"].get("searchable", [])
        allowed_fields = set(filterable + searchable)

        for category, fields in apply_filters.items():
            for f in fields:
                if f not in allowed_fields:
                    return False, (
                        f"Field '{f}' under '{category}' must be present in either "
                        f"searchable or filterable fields of AzureAIConfig."
                    )

        return True, None

    except Exception as e:
        return False, f"Unexpected validation error: {str(e)}"


# ------------------- SAFE DATE PARSER -------------------
def parse_date_safe(date_str):
    """Try multiple formats for safety."""
    if not date_str:
        return None

    formats = ["%Y-%m-%d", "%d/%m/%Y", "%Y/%m/%d", "%d-%m-%Y"]
    for fmt in formats:
        try:
            return datetime.strptime(date_str, fmt)
        except:
            continue
    logger.warning("Failed to parse date: %s", date_str)
    return None


