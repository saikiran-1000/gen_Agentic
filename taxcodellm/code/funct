def fetch_config(container_name, blob_name):
    try:
        container_client = blob_service_client.get_container_client(container_name)
        blob_client = container_client.get_blob_client(blob_name)

        # Download blob content
        download_stream = blob_client.download_blob()
        config_data = download_stream.readall()

        # Parse JSON string to dict
        config_dict = json.loads(config_data)
        logger.info(f"Fetched {blob_name} from {container_name}")
        return config_dict
    except Exception as e:
        logger.error(f"Error fetching config: {e}")
        return None

def transform_invoice_data(input_data: dict, mapping1: dict):
    """
    Safely transform invoice data using mapping1.
    
    Returns:
        (True, transformed_data) on success
        (False, error_message) on failure
    """

    try:
        # ---------------------------------------------------------
        # Extract mapping sections
        # ---------------------------------------------------------
        header_map = mapping1.get("header", {})
        line_map = mapping1.get("line_detail", {})
        tax_map = mapping1.get("tax_master", {})

        final_output = {}

        # ---------------------------------------------------------
        # Detect header → line items list
        # ---------------------------------------------------------
        line_items_source_key = None
        line_items_target_key = None

        for old_key, new_key in header_map.items():
            if isinstance(input_data.get(old_key), list):
                line_items_source_key = old_key
                line_items_target_key = new_key
                break

        if not line_items_source_key:
            msg = "No line-item list found in header mapping."
            logger.error(msg)
            return False, msg

        # ---------------------------------------------------------
        # Detect line-item → tax master list
        # ---------------------------------------------------------
        sample_line = (input_data.get(line_items_source_key) or [{}])[0]

        tax_master_source_key = None
        tax_master_target_key = None

        for old_key, new_key in line_map.items():
            if isinstance(sample_line.get(old_key), list):
                tax_master_source_key = old_key
                tax_master_target_key = new_key
                break

        if not tax_master_source_key:
            msg = "No tax-master list found inside line-item structure."
            logger.error(msg)
            return False, msg

        # ---------------------------------------------------------
        # Build header-level output
        # ---------------------------------------------------------
        for old_key, new_key in header_map.items():
            if old_key != line_items_source_key:
                final_output[new_key] = input_data.get(old_key)

        # ---------------------------------------------------------
        # Transform line items
        # ---------------------------------------------------------
        transformed_lines = []

        for line in input_data.get(line_items_source_key, []):
            new_line = {}

            # Line-level fields except nested tax list
            for old_key, new_key in line_map.items():
                if old_key != tax_master_source_key:
                    new_line[new_key] = line.get(old_key)

            # Transform tax master nested records
            tax_list = []
            for tax_entry in line.get(tax_master_source_key, []):
                new_tax = {}

                for old_key, new_key in tax_map.items():
                    new_tax[new_key] = tax_entry.get(old_key)

                tax_list.append(new_tax)

            new_line[tax_master_target_key] = tax_list
            transformed_lines.append(new_line)

        # Add transformed line items to final output
        final_output[line_items_target_key] = transformed_lines

        logger.info("Invoice transformation completed successfully.")
        return final_output

    except Exception as e:
        logger.exception(f"Unexpected error during invoice transformation: {e}")
        return f"Exception occurred: {str(e)}"

