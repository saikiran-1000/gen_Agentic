"""GRN Variance Analysis Main Processing Module.

This module serves as the main entry point for processing invoice and GRN (Goods Receipt Note) variance analysis. It orchestrates the complete workflow including input validation, invoice processing with AI-powered recommendations, and output validation.
"""

import logging
from typing import Any, Dict

from input_validation import input_validation
from output_validation import output_validation
from process_invoice import process_invoice


def main(input_data: Dict[str, Any], config: Dict[str, Any]) -> Dict[str, Any]:
    """Process invoice GRN variance analysis with AI-powered recommendations.

    This function orchestrates the complete workflow for analyzing variances between invoice quantities and GRN quantities. It validates input data, processes invoices using historical analysis and AI recommendations, and validates the output format.

    Args:
        input_data (Dict[str, Any]): Invoice data containing:
            - invoiceID: Unique identifier for the invoice
            - vendorID: Vendor identifier
            - invoiceDate: Date of invoice
            - country: Country code where invoice was issued
            - invoiceLineItems: List of line items with quantities and historical data
        config (Dict[str, Any]): Configuration dictionary with field mappings for dynamic model creation.
    Returns:
        Dict[str, Any]: Processed results containing:
            - vendorID: Vendor identifier
            - invoiceLineItemsResults: List of analyzed line items with variances and AI-generated justifications
    """
    logging.info(f"Processing input: {input_data}")

    # Step 1: Validate input data structure and content
    try:
        validated_data = input_validation(input_data, config=config)
    except ValueError as e:
        logging.error(f"Input validation error: {e}")
        return {
            "error": str(e),
            "status": "Input validation failed"
        }

    # Step 2: Process invoice data with variance analysis and AI recommendations
    try:
        processed_invoice = process_invoice(validated_data, config=config)
    except ValueError as e:
        logging.error(f"Invoice processing error: {e}")
        return {
            "error": str(e),
            "status": "Invoice processing failed"
        }

    # Step 3: Validate final output format and structure
    try:
        output_validation(processed_invoice)
    except ValueError as e:
        logging.error(f"Output validation error: {e}")
        return {
            "error": str(e),
            "status": "Output validation failed"
        }

    # return processed_invoice
    return {"status": "success","status_code":200, "data": processed_invoice}
