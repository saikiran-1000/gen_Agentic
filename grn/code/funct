from azure.storage.blob import BlobServiceClient
blob_connection_string = os.getenv('AzureWebJobsStorage')
def get_blob_service_client(blob_connection_string):
    # Initialize BlobServiceClient
    blob_client = BlobServiceClient.from_connection_string(blob_connection_string)
    logger.info(f"blob_service_client, {blob_client}")
    return blob_client

blob_service_client = get_blob_service_client(blob_connection_string)

# ----------------------------------
# FETCH (download config.json)
# ----------------------------------
def fetch_config(container_name, blob_name):
    try:
        container_client = blob_service_client.get_container_client(container_name)
        blob_client = container_client.get_blob_client(blob_name)

        # Download blob content
        download_stream = blob_client.download_blob()
        config_data = download_stream.readall()

        # Parse JSON string to dict
        config_dict = json.loads(config_data)
        logger.info(f"Fetched {blob_name} from {container_name}")
        return config_dict
    except Exception as e:
        logger.error(f"Error fetching config: {e}")
        return None


