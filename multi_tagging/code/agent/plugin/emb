"""
embedding_plugin.py

Reusable embedding plugin for Azure OpenAI embeddings.

Responsibilities:
- Initialize and provide Azure OpenAI embedding client
- Generate embeddings for text inputs
"""

import os
# from dotenv import load_dotenv
from semantic_kernel.functions import kernel_function
from langchain_openai import AzureOpenAIEmbeddings

# load_dotenv()


class EmbeddingPlugin:
    """
    Fully reusable embedding plugin.

    Responsibilities:
    - Initialize Azure OpenAI embedding client
    - Generate embeddings for given text inputs
    """

    def __init__(self):
        """
        Loads environment variables and initializes embedding client.
        """
        self.api_key = os.getenv("AZURE_OPENAI_API_KEY_embed")
        self.azure_endpoint = os.getenv("AZURE_OPENAI_ENDPOINT_embed")
        self.api_version = os.getenv(
            "AZURE_OPENAI_API_VERSION_embed", "2024-02-15-preview"
        )
        self.deployment_name = os.getenv("AZURE_EMBEDDING_DEPLOYMENT_NAME")

        missing = [
            name for name, value in {
                "api_key": self.api_key,
                "azure_endpoint": self.azure_endpoint,
                "deployment_name": self.deployment_name,
            }.items() if not value
        ]

        if missing:
            raise ValueError(
                f"Azure OpenAI embedding configuration is incomplete. Missing: {', '.join(missing)}"
            )


        self.embeddings_client = AzureOpenAIEmbeddings(
            model=self.deployment_name,
            api_key=self.api_key,
            azure_endpoint=self.azure_endpoint,
            api_version=self.api_version
        )

    @kernel_function(
        description="Get the Azure OpenAI embeddings client instance.",
        name="get_embeddings_client"
    )
    def get_embeddings_client(self):
        """
        Returns the initialized embeddings client.

        Returns:
            AzureOpenAIEmbeddings: The embeddings client instance
        """
        return self.embeddings_client

    @kernel_function(
        description="Generate embeddings and attach them to input records.",
        name="generate_embeddings"
    )
    def generate_embeddings(self, data_list):
        """
        Generates embeddings for each item in data_list.

        Expected input format:
        [
            {
                "id": Any,
                "text": str,
                "meta_data": Any (optional)
            }
        ]

        Output:
        - Same list of dicts with an additional key: "embedding"
        """
        if not data_list:
            raise ValueError("Input data_list cannot be empty.")

        texts = [item["text"] for item in data_list]
        embeddings = self.embeddings_client.embed_documents(texts)

        for item, embedding in zip(data_list, embeddings):
            item["embedding"] = embedding

        return data_list
